{
  "functions": [{ "source": "src/functions/deploy", "codebase": "default", "runtime": "nodejs22", "predeploy": ["node scripts/assert-soclaas-dev-target.mjs", "npm run build --workspace src/functions", "npm run verify:deploy-package --workspace src/functions"] }],
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": "src/frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build --workspace frontend"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "ui": { "enabled": false },
    "singleProjectMode": true,
    "startTimeout": "60s"
  }
}
