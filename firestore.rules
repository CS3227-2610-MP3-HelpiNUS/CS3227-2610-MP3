rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userExists() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() {
      return userExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['STUDENT', 'MENTOR']
        && request.auth.token.email_verified == true
        && request.auth.token.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email;
    }
    function acceptedConversation(data, id) {
      return activeUser()
        && data.keys().hasAll(['id', 'helpRequestId', 'studentId', 'mentorId', 'participantIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'helpRequestId', 'studentId', 'mentorId', 'participantIds', 'createdAt', 'updatedAt'])
        && data.id == id
        && data.helpRequestId == id
        && data.studentId is string
        && data.mentorId is string
        && data.participantIds == [data.studentId, data.mentorId]
        && ((role() == 'STUDENT' && request.auth.uid == data.studentId) || (role() == 'MENTOR' && request.auth.uid == data.mentorId))
        && exists(/databases/$(database)/documents/helpRequests/$(id))
        && get(/databases/$(database)/documents/helpRequests/$(id)).data.id == id
        && get(/databases/$(database)/documents/helpRequests/$(id)).data.status == 'ACCEPTED'
        && get(/databases/$(database)/documents/helpRequests/$(id)).data.studentId == data.studentId
        && get(/databases/$(database)/documents/helpRequests/$(id)).data.mentorId == data.mentorId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.createdAt == get(/databases/$(database)/documents/helpRequests/$(id)).data.updatedAt
        && data.updatedAt == get(/databases/$(database)/documents/helpRequests/$(id)).data.updatedAt;
    }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function activeMentor(mentorId) {
      return exists(/databases/$(database)/documents/users/$(mentorId))
        && get(/databases/$(database)/documents/users/$(mentorId)).data.role == 'MENTOR'
        && get(/databases/$(database)/documents/users/$(mentorId)).data.status == 'ACTIVE';
    }
    function schedulableMentor(mentorId) {
      return activeMentor(mentorId)
        && exists(/databases/$(database)/documents/mentorProfiles/$(mentorId))
        && get(/databases/$(database)/documents/mentorProfiles/$(mentorId)).data.userId == mentorId
        && get(/databases/$(database)/documents/mentorProfiles/$(mentorId)).data.active == true;
    }

    match /users/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /mentorProfiles/{uid} {
      allow get: if activeUser() && resource.data.active == true && activeMentor(uid);
      // Collection discovery is served by discoverMentors so every profile can
      // be joined to its authoritative users/{uid} role and status record.
      allow list: if false;
      allow write: if false;
    }
    match /modules/{id} { allow read: if activeUser(); allow write: if false; }
    match /helpRequests/{id} {
      allow get: if activeUser() && ((role() == 'STUDENT' && resource.data.studentId == request.auth.uid) || (role() == 'MENTOR' && resource.data.mentorId == request.auth.uid));
      allow list: if activeUser() && request.query.limit != null && request.query.limit <= 20
        && ((role() == 'STUDENT' && resource.data.studentId == request.auth.uid) || (role() == 'MENTOR' && resource.data.mentorId == request.auth.uid));
      allow write: if false;
    }
    match /helpRequestSummaries/{uid} {
      allow get: if activeUser() && role() == 'STUDENT' && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /helpRequestOperations/{uid}/operations/{operationId} { allow read, write: if false; }
    match /pendingHelpRequestKeys/{key} { allow read, write: if false; }
    match /conversations/{id} {
      allow get: if acceptedConversation(resource.data, id);
      // F02 must supply an authorized list strategy and prove it in Emulator.
      allow list: if false;
      allow write: if false;
      match /messages/{messageId} {
        function conversation() { return get(/databases/$(database)/documents/conversations/$(id)).data; }
        allow get: if exists(/databases/$(database)/documents/conversations/$(id)) && acceptedConversation(conversation(), id);
        allow list: if request.query.limit != null && request.query.limit <= 20
          && exists(/databases/$(database)/documents/conversations/$(id)) && acceptedConversation(conversation(), id);
        allow write: if false;
      }
    }
    match /availabilitySlots/{id} {
      function ownMentorSlot() {
        return role() == 'MENTOR' && resource.data.get('mentorId', '') == request.auth.uid;
      }
      function publicOpenSlot() {
        return resource.data.get('status', '') == 'OPEN'
          && resource.data.get('appointmentId', 'MISSING') == null;
      }
      allow get: if activeUser() && (ownMentorSlot() || (publicOpenSlot() && schedulableMentor(resource.data.get('mentorId', ''))));
      // Firestore cannot prove a cross-document Mentor/profile predicate for a
      // collection query. The query exposes only unbooked OPEN projections;
      // reserveAppointment rechecks the current Auth user and Mentor profile.
      allow list: if activeUser() && request.query.limit != null && request.query.limit <= 100
        && (ownMentorSlot() || publicOpenSlot());
      allow write: if false;
    }
    match /appointments/{id} {
      function ownsAppointment() {
        return activeUser() && (
          (role() == 'STUDENT' && resource.data.get('studentId', '') == request.auth.uid)
          || (role() == 'MENTOR' && resource.data.get('mentorId', '') == request.auth.uid)
        );
      }
      allow get: if ownsAppointment();
      allow list: if request.query.limit != null && request.query.limit <= 100 && ownsAppointment();
      allow write: if false;
    }
    match /appointmentOperations/{uid}/operations/{requestId} { allow read, write: if false; }
    match /availabilitySlotLocks/{id} { allow read, write: if false; }
    match /studentAppointmentLocks/{id} { allow read, write: if false; }
    match /aiAuditEvents/{id} { allow read, write: if false; }
  }
}
