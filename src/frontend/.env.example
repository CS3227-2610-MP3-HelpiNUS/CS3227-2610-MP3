# Firebase web configuration is public client configuration, not a secret.
# Keep development and production values in separate local env files.
VITE_FIREBASE_ENV=development
VITE_USE_FIREBASE_EMULATORS=false

VITE_FIREBASE_DEV_API_KEY=
VITE_FIREBASE_DEV_AUTH_DOMAIN=
VITE_FIREBASE_DEV_PROJECT_ID=helpinus-dev
VITE_FIREBASE_DEV_APP_ID=
VITE_FIREBASE_DEV_MESSAGING_SENDER_ID=

# Set VITE_FIREBASE_ENV=production in the production build environment and
# provide only the helpinus-prod project's web configuration values.
VITE_FIREBASE_PROD_API_KEY=
VITE_FIREBASE_PROD_AUTH_DOMAIN=
VITE_FIREBASE_PROD_PROJECT_ID=helpinus-prod
VITE_FIREBASE_PROD_APP_ID=
VITE_FIREBASE_PROD_MESSAGING_SENDER_ID=
